NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Defaults to true in production and false otherwise
REQUIRE_EMAIL_VERIFICATION=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave SMTP_HOST empty to log emails to the console instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# gemini | openai | claude | groq | mistral | bluesminds
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
MISTRAL_API_KEY=
BLUESMINDS_API_KEY=
