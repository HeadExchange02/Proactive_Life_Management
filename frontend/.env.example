# The frontend calls the backend via the /api proxy configured in vite.config.js
# during development, so no VITE_API_URL is needed locally.
# In production, set this to your deployed backend URL and update axios
# baseURL in src/services/api.js accordingly.
VITE_API_URL=http://localhost:4000/api

# Google OAuth client ID (public, used by the Google Sign-In button)
VITE_GOOGLE_CLIENT_ID=
